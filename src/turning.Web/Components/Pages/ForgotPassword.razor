@page "/forgot-password"
@layout EmptyLayout

@inject AuthApiClient AuthApiClient

<PageTitle>SUE — Recuperar contraseña</PageTitle>

<div class="login-container">
    <div class="login-left paper">
        <div class="login-card rise-in">
            <div class="sue-logo">
                <div class="sue-logo-icon">◦</div>
                <h1 class="sue-logo-text">SUE</h1>
                <p class="sue-logo-subtitle">Sistema de Usuario con Empatía</p>
                <p style="margin-top: 8px; font-size: 14px; color: var(--barro-claro);">
                    Te enviaremos un enlace para elegir una contraseña nueva
                </p>
            </div>

            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <div class="card-tierra" role="alert" style="background: #FDECEC; border-color: #E8B4B4; margin-bottom: 16px; padding: 16px;">
                    <p style="margin: 0; color: #8B4A4A; font-size: 14px;">@_errorMessage</p>
                </div>
            }

            @if (_sent)
            {
                @* El mismo texto exista o no la cuenta: la página no debe revelar qué correos están registrados. *@
                <div class="card-tierra" role="status" style="margin-bottom: 16px; padding: 16px;">
                    <p style="margin: 0; font-size: 14px;">
                        Si el correo está registrado, te enviamos un enlace para restablecer la contraseña.
                        Revisa tu bandeja de entrada y también la carpeta de correo no deseado.
                    </p>
                </div>
            }
            else
            {
                <EditForm FormName="forgot-password-form" Model="_model" OnValidSubmit="HandleSubmitAsync">
                    <DataAnnotationsValidator />

                    <div style="margin-bottom: 20px;">
                        <label for="forgot-email" style="display: block; margin-bottom: 8px; font-weight: 700; font-size: 14px;">
                            Correo electrónico
                        </label>
                        <InputText id="forgot-email" class="input-tierra" @bind-Value="_model.Email"
                                   placeholder="tu@email.com" autocomplete="username" />
                        <ValidationMessage For="@(() => _model.Email)"
                                           style="color: #A87B64; font-size: 13px; margin-top: 4px; display: block;" />
                    </div>

                    <button type="submit" class="btn-tierra" disabled="@_isSubmitting">
                        @(_isSubmitting ? "◦ Enviando..." : "◦ Enviar enlace")
                    </button>
                </EditForm>
            }

            <p style="text-align: center; margin-top: 24px; font-size: 14px; color: var(--barro-claro);">
                ¿Ya la recordaste?
                <a href="/login" style="color: var(--terracota-oscura); font-weight: 800; text-decoration: none;">
                    Ir al inicio de sesión
                </a>
            </p>
        </div>
    </div>

    <div class="login-right linen">
        <div class="avatar-container">
            <div style="text-align: center;">
                <div class="avatar-circle breathe">
                    <img src="images/sue-logo.png" alt="Logo SUE" class="sue-avatar-logo" />
                </div>
                <p style="margin-top: 32px; font-family: var(--font-display); font-size: 34px; font-weight: 700;
                          color: var(--barro); line-height: 1.2; max-width: 420px;">
                    Volvamos a abrirte la puerta.
                </p>
            </div>
        </div>
    </div>
</div>

@code {
    private readonly ForgotPasswordInputModel _model = new();
    private bool _isSubmitting;
    private bool _sent;
    private string? _errorMessage;

    private async Task HandleSubmitAsync()
    {
        _errorMessage = null;
        _isSubmitting = true;

        try
        {
            await AuthApiClient.ForgotPasswordAsync(_model.Email.Trim());
            _sent = true;
        }
        catch (ApiException exception)
        {
            _errorMessage = exception.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private sealed class ForgotPasswordInputModel
    {
        [Required(ErrorMessage = "El correo es obligatorio.")]
        [EmailAddress(ErrorMessage = "Debes escribir un correo válido.")]
        public string Email { get; set; } = string.Empty;
    }
}
