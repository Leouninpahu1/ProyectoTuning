@page "/results"
@attribute [Authorize]
@using turning.Web.ExperimentSessions
@inject ExperimentSessionApiClient Sessions
@inject IJSRuntime JS

<PageTitle>SUE — Resultados</PageTitle>
<div class="sue-page">
    <header class="sue-header"><p class="sue-eyebrow">Evidencia</p><h1 class="sue-title">Resultados de la sesión</h1><p class="sue-subtitle">Datos registrados durante el experimento, sin indicadores simulados.</p></header>
    <AuthorizeView Roles="Researcher,Administrator">
        <div class="sue-card">
            <h2 class="sue-card-title">Sesiones para investigación</h2>
            <button class="btn-ghost" disabled="@_loadingList" @onclick="LoadListAsync">Actualizar listado</button>
            @if (_listError is not null) { <p role="alert">@_listError</p> }
            @foreach (var session in _all)
            {
                <p><a href="/results?sessionId=@session.Id">@session.SessionCode</a> · @session.Condition · @session.Status · @session.CreatedAtUtc.ToLocalTime().ToString("g")</p>
            }
            <div style="display:flex;gap:12px;align-items:center"><button class="btn-ghost" disabled="@(_loadingList || _page == 1)" @onclick="PreviousAsync">Anterior</button><span>Página @_page · @_total sesiones</span><button class="btn-ghost" disabled="@(_loadingList || _page * 20 >= _total)" @onclick="NextAsync">Siguiente</button></div>
        </div>
    </AuthorizeView>
    <SessionSelector SessionId="SessionId" OnSelected="LoadAsync" />
    @if (_error is not null) { <div class="sue-card" role="alert">@_error</div> }
    @if (_session is not null && !_session.IsTerminal && _session.IsOwner)
    {
        <div class="sue-card"><p>El resultado completo estará disponible cuando termine la sesión.</p><a href="/conversations?sessionId=@_session.Id">Volver a la conversación</a></div>
    }
    @if (_result is not null)
    {
        <div class="sue-card">
            <h2 class="sue-card-title">@_result.Session.SessionCode · @_result.Session.Status</h2>
            <div class="sue-info-grid"><p>@_result.Conversation.Count mensajes</p><p>@_result.EmotionReadings.Count lecturas emocionales</p><p>@_result.AvatarExpressions.Count expresiones</p><p>@_result.Survey.Count(s => s.SubmittedAtUtc.HasValue) encuestas enviadas</p></div>
            <AuthorizeView Roles="Researcher,Administrator"><p>Condición experimental: @_result.Session.Condition</p><p>Operaciones degradadas registradas: @_result.DegradedEvents.Count</p></AuthorizeView>
            <button class="btn-ghost" @onclick="ExportAsync">Descargar datos de esta sesión</button>
        </div>
        <div class="sue-card"><h2 class="sue-card-title">Conversación registrada</h2>
            @if (_result.Conversation.Count == 0) { <p>No se registraron mensajes.</p> }
            @foreach (var turn in _result.Conversation) { <div style="padding:12px 0;border-bottom:1px solid var(--arena-media)"><p><strong>@(turn.Sender == "Participant" ? "Participante" : "SUE")</strong> · @turn.CreatedAtUtc.ToLocalTime().ToString("g")</p><p>@turn.Message</p></div> }
        </div>
        <div class="sue-two-cols">
            <div class="sue-card"><h2 class="sue-card-title">Lecturas emocionales</h2>@if (_result.EmotionReadings.Count == 0) { <p>Sin lecturas.</p> }@foreach (var reading in _result.EmotionReadings) { <p>@reading.Emotion · @reading.Score.ToString("P0") · @reading.CapturedAtUtc.ToLocalTime().ToString("g")</p> }</div>
            <div class="sue-card"><h2 class="sue-card-title">Expresiones derivadas</h2>@if (_result.AvatarExpressions.Count == 0) { <p>Sin expresiones.</p> }@foreach (var avatar in _result.AvatarExpressions) { <p>@avatar.ExpressionName · @avatar.Intensity.ToString("P0") @(avatar.IsFallback ? "(respaldo)" : "")</p> }</div>
        </div>
        <div class="sue-card"><h2 class="sue-card-title">Encuesta</h2>
            @if (!_result.Survey.Any(s => s.SubmittedAtUtc.HasValue)) { <p>Aún no hay encuesta enviada.</p>@if (_session?.IsOwner == true && _session.IsTerminal) { <a href="/surveys?sessionId=@_session.Id">Responder encuesta</a> } }
            @foreach (var response in _result.Survey) { <p>Enviada: @(response.SubmittedAtUtc?.ToLocalTime().ToString("g") ?? "Pendiente")</p>@foreach (var answer in response.Answers) { <p>@QuestionLabel(answer.QuestionId): @answer.Value</p> } }
        </div>
    }
</div>
@code {
    [SupplyParameterFromQuery] public Guid? SessionId { get; set; }
    private ExperimentSessionSnapshotDto? _session;
    private SessionResultDto? _result;
    private SurveyDefinitionDto? _definition;
    private List<ExperimentSessionSnapshotDto> _all = [];
    private int _page = 1, _total;
    private string? _error, _listError;
    private bool _loadingList;
    [CascadingParameter] public Task<AuthenticationState> AuthenticationState { get; set; } = default!;
    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationState).User;
        if (user.IsInRole("Researcher") || user.IsInRole("Administrator")) await LoadListAsync();
    }
    private async Task LoadAsync(ExperimentSessionSnapshotDto? session)
    {
        _session = session; _result = null; _definition = null; _error = null;
        if (session is null || (session.IsOwner && !session.IsTerminal)) return;
        try
        {
            _result = await Sessions.GetResultAsync(session.Id);
            if (session.IsTerminal && _result.Survey.Count > 0) _definition = await Sessions.GetSurveyAsync(session.Id);
        }
        catch (ApiException ex) { _error = ex.Message; }
    }
    private string QuestionLabel(Guid id) => _definition?.Questions.FirstOrDefault(q => q.Id == id)?.Text ?? $"Pregunta {id}";
    private Task PreviousAsync() { _page--; return LoadListAsync(); }
    private Task NextAsync() { _page++; return LoadListAsync(); }
    private async Task LoadListAsync()
    {
        if (_loadingList) return;
        _loadingList = true; _listError = null;
        try { var result = await Sessions.ListResultsAsync(_page); _all = result.Items; _total = result.Total; }
        catch (ApiException ex) { _listError = ex.Message; }
        finally { _loadingList = false; }
    }
    private async Task ExportAsync()
    {
        if (_result is null) return;
        var user = (await AuthenticationState).User;
        object report = user.IsInRole("Researcher") || user.IsInRole("Administrator") ? _result : new
        {
            _result.Session.SessionCode,
            _result.Session.Status,
            _result.Conversation,
            Emotions = _result.EmotionReadings.Select(e => new { e.Emotion, e.Score, e.CapturedAtUtc }),
            Expressions = _result.AvatarExpressions.Select(a => new { a.ExpressionName, a.Intensity }),
            _result.Survey
        };
        await JS.InvokeVoidAsync("sueDownloadJson", $"sue-{_result.Session.SessionCode}.json", System.Text.Json.JsonSerializer.Serialize(report, new System.Text.Json.JsonSerializerOptions { WriteIndented = true }));
    }
}
