@page "/reset-password"
@layout EmptyLayout

@inject AuthApiClient AuthApiClient

<PageTitle>SUE — Nueva contraseña</PageTitle>

<div class="login-container">
    <div class="login-left paper">
        <div class="login-card rise-in">
            <div class="sue-logo">
                <div class="sue-logo-icon">◦</div>
                <h1 class="sue-logo-text">SUE</h1>
                <p class="sue-logo-subtitle">Sistema de Usuario con Empatía</p>
                <p style="margin-top: 8px; font-size: 14px; color: var(--barro-claro);">
                    Elige una contraseña nueva para tu cuenta
                </p>
            </div>

            @if (_done)
            {
                <div class="card-tierra" role="status" style="margin-bottom: 16px; padding: 16px;">
                    <p style="margin: 0; font-size: 14px;">Tu contraseña se actualizó. Ya puedes iniciar sesión con la nueva.</p>
                </div>
                <a href="/login" class="btn-tierra" style="display: block; text-align: center; text-decoration: none;">◦ Ir al inicio de sesión</a>
            }
            else if (string.IsNullOrWhiteSpace(Token) || _errorMessage is not null)
            {
                <div class="card-tierra" role="alert" style="background: #FDECEC; border-color: #E8B4B4; margin-bottom: 16px; padding: 16px;">
                    <p style="margin: 0; color: #8B4A4A; font-size: 14px;">
                        @(_errorMessage ?? "El enlace de restablecimiento no es válido o ya venció. Pide uno nuevo.")
                    </p>
                </div>
                <a href="/forgot-password" class="btn-tierra" style="display: block; text-align: center; text-decoration: none;">◦ Pedir un enlace nuevo</a>
            }
            else
            {
                <EditForm FormName="reset-password-form" Model="_model" OnValidSubmit="HandleSubmitAsync">
                    <DataAnnotationsValidator />

                    <div style="margin-bottom: 16px;">
                        <label for="reset-password" style="display: block; margin-bottom: 8px; font-weight: 700; font-size: 14px;">
                            Contraseña nueva
                        </label>
                        <InputText id="reset-password" class="input-tierra" @bind-Value="_model.NewPassword"
                                   type="password" placeholder="Al menos 8 caracteres" autocomplete="new-password" />
                        <ValidationMessage For="@(() => _model.NewPassword)"
                                           style="color: #A87B64; font-size: 13px; margin-top: 4px; display: block;" />
                    </div>

                    <div style="margin-bottom: 20px;">
                        <label for="reset-confirm" style="display: block; margin-bottom: 8px; font-weight: 700; font-size: 14px;">
                            Confirmar contraseña
                        </label>
                        <InputText id="reset-confirm" class="input-tierra" @bind-Value="_model.ConfirmPassword"
                                   type="password" placeholder="Repite tu contraseña" autocomplete="new-password" />
                        <ValidationMessage For="@(() => _model.ConfirmPassword)"
                                           style="color: #A87B64; font-size: 13px; margin-top: 4px; display: block;" />
                    </div>

                    <button type="submit" class="btn-tierra" disabled="@_isSubmitting">
                        @(_isSubmitting ? "◦ Guardando..." : "◦ Cambiar contraseña")
                    </button>
                </EditForm>
            }
        </div>
    </div>

    <div class="login-right linen">
        <div class="avatar-container">
            <div style="text-align: center;">
                <div class="avatar-circle breathe">
                    <img src="images/sue-logo.png" alt="Logo SUE" class="sue-avatar-logo" />
                </div>
                <p style="margin-top: 32px; font-family: var(--font-display); font-size: 34px; font-weight: 700;
                          color: var(--barro); line-height: 1.2; max-width: 420px;">
                    Un comienzo nuevo, a tu ritmo.
                </p>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private readonly ResetPasswordInputModel _model = new();
    private bool _isSubmitting;
    private bool _done;
    private string? _errorMessage;

    private async Task HandleSubmitAsync()
    {
        _errorMessage = null;
        _isSubmitting = true;

        try
        {
            await AuthApiClient.ResetPasswordAsync(Token!, _model.NewPassword);
            _done = true;
        }
        catch (ApiException exception)
        {
            // La API da el mismo error para un enlace vencido, usado o alterado; se ofrece pedir otro.
            _errorMessage = exception.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private sealed class ResetPasswordInputModel
    {
        [Required(ErrorMessage = "La contraseña es obligatoria.")]
        [MinLength(8, ErrorMessage = "La contraseña debe tener al menos 8 caracteres.")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Debes confirmar la contraseña.")]
        [Compare(nameof(NewPassword), ErrorMessage = "Las contraseñas no coinciden.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
