@page "/emotions"
@attribute [Authorize]
@using turning.Web.ExperimentSessions
@inject ExperimentSessionApiClient Sessions

<PageTitle>SUE — Lectura de Emociones</PageTitle>
<div class="sue-page">
    <header class="sue-header">
        <p class="sue-eyebrow">◇ Conciencia</p>
        <h1 class="sue-title">Emociones de la sesión</h1>
        <p class="sue-subtitle">Lecturas registradas y autoinforme del participante.</p>
    </header>
    <SessionSelector SessionId="SessionId" OnSelected="LoadAsync" />
    @if (_error is not null) { <div class="sue-card" role="alert">@_error</div> }
    @if (_confirmation is not null) { <div class="sue-card" role="status">@_confirmation</div> }
    @if (_session is not null)
    {
        <div class="sue-two-cols">
            <div class="sue-card">
                <h2 class="sue-card-title">Balance emocional</h2>
                <EmotionIntensityChart Levels="EmotionLevels" Colors="EmotionColors" />
                <p class="sue-subtitle">Última intensidad registrada de cada emoción en esta sesión.</p>
            </div>
            @if (_session.IsOwner && _session.Status == "Active")
            {
                <div class="sue-card">
                    <h2 class="sue-card-title">Registrar cómo te sientes</h2>
                    <div class="sue-form-field">
                        <label class="sue-form-label" for="emotion-name">Emoción</label>
                        <select id="emotion-name" class="input-tierra" @bind="_emotion" disabled="@_busy">
                            <option value="joy">Alegría</option>
                            <option value="sadness">Tristeza</option>
                            <option value="anger">Enojo</option>
                            <option value="surprise">Sorpresa</option>
                            <option value="fear">Miedo</option>
                            <option value="disgust">Asco</option>
                            <option value="neutral">Neutral</option>
                        </select>
                    </div>
                    <div class="sue-form-field">
                        <label class="sue-form-label" for="emotion-score">Intensidad: @_intensity / 10</label>
                        <input id="emotion-score" class="sue-slider" type="range" min="0" max="10" @bind="_intensity" @bind:event="oninput" disabled="@_busy" />
                    </div>
                    <button class="btn-tierra" disabled="@_busy" @onclick="SaveAsync">@(_busy ? "Guardando…" : "Guardar lectura emocional")</button>
                </div>
            }
        </div>
        <div class="sue-card">
            <h2 class="sue-card-title">Lecturas persistidas</h2>
            @if (_readings.Length == 0) { <p>No hay lecturas registradas.</p> }
            @foreach (var reading in _readings.OrderByDescending(reading => reading.CapturedAtUtc))
            {
                <div style="padding:12px 0;border-bottom:1px solid var(--arena-media)"><strong>@EmotionLabel(reading.Emotion)</strong> · @reading.Score.ToString("P0") · @reading.Source · @reading.CapturedAtUtc.ToLocalTime().ToString("g")</div>
            }
            <button class="btn-ghost" disabled="@_busy" @onclick="RefreshAsync">Actualizar lecturas</button>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery] public Guid? SessionId { get; set; }
    private ExperimentSessionSnapshotDto? _session;
    private EmotionDto[] _readings = [];
    private string _emotion = "neutral";
    private int _intensity = 5;
    private bool _busy;
    private string? _error, _confirmation;

    private IReadOnlyDictionary<string, int> EmotionLevels => _readings
        .Where(reading => !string.IsNullOrWhiteSpace(reading.Emotion))
        .GroupBy(reading => EmotionLabel(reading.Emotion), StringComparer.OrdinalIgnoreCase)
        .ToDictionary(group => group.Key, group => (int)Math.Round(Math.Clamp(group.OrderByDescending(reading => reading.CapturedAtUtc).First().Score, 0, 1) * 100), StringComparer.OrdinalIgnoreCase);

    private static readonly IReadOnlyDictionary<string, string> EmotionColors = new Dictionary<string, string>
    {
        ["Alegría"] = "#E8C9A0", ["Neutral"] = "#B5C4B1", ["Tristeza"] = "#D4B8A7",
        ["Enojo"] = "#C4957A", ["Sorpresa"] = "#D5C4D4", ["Confusión"] = "#C2B6CF",
        ["Miedo"] = "#B8C3D4", ["Asco"] = "#C6CBA3"
    };

    private async Task LoadAsync(ExperimentSessionSnapshotDto? session)
    {
        _session = session;
        _readings = [];
        _error = null;
        _confirmation = null;
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        if (_session is null) return;
        var sessionId = _session.Id;
        _error = null;
        try
        {
            var readings = await Sessions.GetEmotionsAsync(sessionId);
            var session = await Sessions.GetByIdAsync(sessionId);
            if (_session?.Id != sessionId) return;
            _readings = readings;
            _session = session;
        }
        catch (ApiException ex) { if (_session?.Id == sessionId) _error = ex.Message; }
    }

    private async Task SaveAsync()
    {
        if (_busy || _session is not { IsOwner: true, Status: "Active" }) return;
        var sessionId = _session.Id;
        _busy = true;
        _error = null;
        _confirmation = null;
        try
        {
            await Sessions.AddEmotionAsync(sessionId, _emotion, _intensity / 10.0);
            if (_session?.Id != sessionId) return;
            _confirmation = "La lectura quedó guardada con esta sesión.";
            await RefreshAsync();
        }
        catch (ApiException ex) { if (_session?.Id == sessionId) _error = ex.Message; }
        finally { _busy = false; }
    }

    private static string EmotionLabel(string emotion) => emotion.Trim().ToLowerInvariant() switch
    {
        "joy" => "Alegría", "neutral" => "Neutral", "sadness" => "Tristeza",
        "anger" => "Enojo", "surprise" => "Sorpresa", "confusion" => "Confusión",
        "fear" => "Miedo", "disgust" => "Asco", _ => emotion.Trim()
    };
}
