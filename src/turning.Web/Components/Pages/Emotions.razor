@page "/emotions"
@attribute [Authorize]
@using turning.Web.ExperimentSessions
@inject ExperimentSessionApiClient Sessions

<PageTitle>SUE — Emociones</PageTitle>
<div class="sue-page">
    <header class="sue-header"><p class="sue-eyebrow">Conciencia</p><h1 class="sue-title">Emociones de la sesión</h1><p class="sue-subtitle">Lecturas registradas y autoinforme del participante.</p></header>
    <SessionSelector SessionId="SessionId" OnSelected="LoadAsync" />
    @if (_error is not null) { <div class="sue-card" role="alert">@_error</div> }
    @if (_confirmation is not null) { <div class="sue-card" role="status">@_confirmation</div> }
    @if (_session is not null)
    {
        @if (_session.IsOwner && _session.Status == "Active")
        {
            <div class="sue-card">
                <h2 class="sue-card-title">Registrar cómo te sientes</h2>
                <label class="sue-form-label" for="emotion-name">Emoción</label>
                <select id="emotion-name" class="input-tierra" @bind="_emotion"><option value="joy">Alegría</option><option value="sadness">Tristeza</option><option value="anger">Enojo</option><option value="surprise">Sorpresa</option><option value="neutral">Neutral</option></select>
                <label class="sue-form-label" for="emotion-score">Intensidad: @_intensity / 10</label><input id="emotion-score" class="sue-slider" type="range" min="0" max="10" @bind="_intensity" />
                <button class="btn-tierra" disabled="@_busy" @onclick="SaveAsync">@(_busy ? "Guardando…" : "Guardar lectura emocional")</button>
            </div>
        }
        <div class="sue-card">
            <h2 class="sue-card-title">Lecturas persistidas</h2>
            @if (_readings.Length == 0) { <p>No hay lecturas registradas.</p> }
            @foreach (var reading in _readings)
            {
                <div style="padding:12px 0;border-bottom:1px solid var(--arena-media)"><strong>@reading.Emotion</strong> · @reading.Score.ToString("P0") · @reading.Source · @reading.CapturedAtUtc.ToLocalTime().ToString("g")</div>
            }
            <button class="btn-ghost" disabled="@_busy" @onclick="RefreshAsync">Actualizar lecturas</button>
        </div>
    }
</div>
@code {
    [SupplyParameterFromQuery] public Guid? SessionId { get; set; }
    private ExperimentSessionSnapshotDto? _session;
    private EmotionDto[] _readings = [];
    private string _emotion = "neutral";
    private int _intensity = 5;
    private bool _busy;
    private string? _error, _confirmation;
    private async Task LoadAsync(ExperimentSessionSnapshotDto? session) { _session = session; _readings = []; _confirmation = null; await RefreshAsync(); }
    private async Task RefreshAsync()
    {
        if (_session is null) return;
        _error = null;
        try { _readings = await Sessions.GetEmotionsAsync(_session.Id); _session = await Sessions.GetByIdAsync(_session.Id); }
        catch (ApiException ex) { _error = ex.Message; }
    }
    private async Task SaveAsync()
    {
        if (_busy || _session is null) return;
        _busy = true; _error = null; _confirmation = null;
        try { await Sessions.AddEmotionAsync(_session.Id, _emotion, _intensity / 10.0); _confirmation = "La lectura quedó guardada con esta sesión."; await RefreshAsync(); }
        catch (ApiException ex) { _error = ex.Message; }
        finally { _busy = false; }
    }
}
