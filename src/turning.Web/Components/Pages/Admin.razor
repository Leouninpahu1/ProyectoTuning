@page "/admin"
@attribute [Authorize(Roles = "Administrator,Researcher")]

@using System.Net
@using System.Text.Json
@using turning.Web.ExperimentSessions

@implements IDisposable
@inject ExperimentSessionApiClient ExperimentSessionApiClient
@inject AuthApiClient AuthApiClient
@inject NavigationManager NavigationManager
@inject TokenAuthenticationStateProvider AuthStateProvider

<PageTitle>SUE — Estadísticas</PageTitle>

<div class="sue-page">
    <header class="sue-header admin-header">
        <div>
            <p class="sue-eyebrow">▤ Administración</p>
            <h1 class="sue-title">Estadísticas emocionales</h1>
            <p class="sue-subtitle">@(_isHistory ? "Lecturas de sesiones finalizadas, expiradas o canceladas." : "Lecturas de las sesiones que están activas en este momento.")</p>
        </div>
        <button class="btn-ghost admin-refresh" @onclick="LoadAsync" disabled="@_isLoading">
            @(_isLoading ? "Actualizando..." : "Actualizar")
        </button>
    </header>

    <div class="admin-toolbar">
        <div class="admin-views" role="group" aria-label="Vista de estadísticas">
            <button class="admin-view @(!_isHistory ? "is-selected" : null)" aria-pressed="@(!_isHistory ? "true" : "false")"
                    disabled="@_isLoading" @onclick="() => ChangeViewAsync(false)">En vivo</button>
            <button class="admin-view @(_isHistory ? "is-selected" : null)" aria-pressed="@(_isHistory ? "true" : "false")"
                    disabled="@_isLoading" @onclick="() => ChangeViewAsync(true)">Historial</button>
        </div>
        <p class="admin-updated" role="status" aria-live="polite">
            @if (_lastUpdated is { } updated)
            {
                <span>Actualizado a las <time datetime="@updated.ToString("O")">@updated.ToString("HH:mm:ss")</time> · Cada 10 segundos</span>
            }
            else
            {
                <span>Actualización automática cada 10 segundos</span>
            }
        </p>
    </div>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="sue-card admin-error" role="alert">
            <p>@_errorMessage</p>
            @if (_rows is not null)
            {
                <p>Se conserva la última actualización disponible.</p>
            }
        </div>
    }

    @if (_rows is null && string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="sue-card" role="status"><p class="sue-info-value">Cargando estadísticas...</p></div>
    }
    else if (_rows is not null)
    {
        <div class="sue-stats-grid">
            <div class="sue-stat-card">
                <div class="sue-stat-icon">◦</div>
                <p class="sue-stat-value">@_rows.Count</p>
                <p class="sue-stat-label">@(_isHistory ? "Sesiones finalizadas" : "Sesiones activas")</p>
            </div>
            <div class="sue-stat-card">
                <div class="sue-stat-icon">◇</div>
                <p class="sue-stat-value">@_totals.Values.Sum()</p>
                <p class="sue-stat-label">Lecturas emocionales</p>
            </div>
            <div class="sue-stat-card">
                <div class="sue-stat-icon">○</div>
                <p class="sue-stat-value">@PredominantEmotion</p>
                <p class="sue-stat-label">Emoción predominante</p>
            </div>
            <div class="sue-stat-card">
                <div class="sue-stat-icon">≈</div>
                <p class="sue-stat-value">@_degraded</p>
                <p class="sue-stat-label">Lecturas de respaldo</p>
            </div>
        </div>

        @if (_rows.Count == 0)
        {
            <div class="sue-card admin-empty" role="status">
                <h2 class="sue-card-title">@(_isHistory ? "Aún no hay sesiones finalizadas" : "No hay sesiones activas")</h2>
                <p class="sue-subtitle">
                    @(_isHistory
                        ? "Las lecturas aparecerán aquí cuando una sesión finalice, expire o sea cancelada."
                        : "Cuando un participante inicie una conversación, sus lecturas aparecerán aquí. Puedes consultar las sesiones anteriores en Historial.")
                </p>
            </div>
        }

        <div class="sue-card">
            <EmotionDistributionChart Counts="_totals" Title="@(_isHistory ? "Distribución de emociones · Historial" : "Distribución de emociones · En vivo")" />
        </div>

        @if (_rows.Count > 0)
        {
            <h2 class="sue-card-title admin-sessions-heading">Detalle por sesión</h2>
        }

        @foreach (var row in _rows)
        {
            <details class="sue-card admin-session" @key="row.Session.Id">
                <summary>
                    <span class="admin-session-name">@row.Session.SessionCode</span>
                    <span class="admin-session-badge">@StatusLabel(row.Session.Status)</span>
                    <span class="admin-session-count">@row.Counts.Values.Sum() lecturas · @row.Session.ConversationTurnCount mensajes</span>
                </summary>
                <div class="sue-info-grid admin-session-info">
                    <div>
                        <p class="sue-info-label">Condición</p>
                        <p class="sue-info-value">@(row.Session.Condition == "AI" ? "IA" : "Humana")</p>
                    </div>
                    <div>
                        <p class="sue-info-label">Última emoción</p>
                        <p class="sue-info-value">@EmotionLabel(row.Session.LastDetectedEmotion)</p>
                    </div>
                    <div>
                        <p class="sue-info-label">Creada</p>
                        <p class="sue-info-value">@row.Session.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
                    </div>
                </div>
                <EmotionDistributionChart Counts="row.Counts" Title="@($"Emociones de {row.Session.SessionCode}")" />
            </details>
        }
    }

    @* Fuera del bloque de estadísticas: si estas fallan, los roles se siguen pudiendo gestionar. *@
    <AuthorizeView Roles="Administrator">
        <div class="sue-card" id="roles">
            <h2 class="sue-card-title">Roles de usuario</h2>
            <p class="sue-subtitle">Busca una cuenta por nombre o correo y cambia su rol. La persona debe volver a iniciar sesión para que el cambio se aplique.</p>

            <form @onsubmit="SearchUsersAsync" @onsubmit:preventDefault style="display: flex; gap: 12px; flex-wrap: wrap; align-items: flex-end; margin: 16px 0;">
                <div style="flex: 1; min-width: 220px;">
                    <label for="role-search" class="sue-form-label">Buscar cuenta</label>
                    <input id="role-search" class="input-tierra" @bind="_userQuery" placeholder="Nombre o correo" />
                </div>
                <button type="submit" class="btn-ghost" style="width: auto;" disabled="@_usersBusy">Buscar</button>
            </form>

            @if (_usersError is not null)
            {
                <p role="alert" style="color: #8B4A4A;">@_usersError</p>
            }
            @if (_roleNotice is not null)
            {
                <p role="status" style="color: var(--salvia-oscura); font-weight: 700;">@_roleNotice</p>
            }

            @if (_users is null)
            {
                <p class="sue-subtitle">Cargando cuentas...</p>
            }
            else if (_users.Items.Count == 0)
            {
                <p class="sue-subtitle">No hay cuentas que coincidan con la búsqueda.</p>
            }
            else
            {
                <div style="overflow-x: auto;">
                    <table style="width: 100%; border-collapse: collapse; font-size: 14px;">
                        <thead>
                            <tr>
                                <th style="text-align: left; padding: 8px;">Nombre</th>
                                <th style="text-align: left; padding: 8px;">Correo</th>
                                <th style="text-align: left; padding: 8px;">Rol</th>
                                <th style="text-align: left; padding: 8px;">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var account in _users.Items)
                            {
                                <tr style="border-top: 1px solid var(--arena-media);">
                                    <td style="padding: 10px 8px;">@account.FullName</td>
                                    <td style="padding: 10px 8px; word-break: break-all;">@account.Email</td>
                                    <td style="padding: 10px 8px;">
                                        <select class="input-tierra" aria-label="Rol de @account.Email" value="@RoleFor(account)"
                                                @onchange="change => _pendingRoles[account.Id] = change.Value?.ToString() ?? account.Role">
                                            @foreach (var role in Roles)
                                            {
                                                <option value="@role">@role</option>
                                            }
                                        </select>
                                    </td>
                                    <td style="padding: 10px 8px;">
                                        <button class="btn-tierra" style="width: auto; padding: 8px 18px;"
                                                disabled="@(_usersBusy || RoleFor(account) == account.Role)" @onclick="() => SaveRoleAsync(account)">
                                            Guardar
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap; margin-top: 16px;">
                    <button class="btn-ghost" style="width: auto;" disabled="@(_usersBusy || _usersPage == 1)" @onclick="() => LoadUsersAsync(_usersPage - 1)">Anterior</button>
                    <span>Página @_usersPage · @_users.Total cuentas</span>
                    <button class="btn-ghost" style="width: auto;" disabled="@(_usersBusy || _usersPage * _users.PageSize >= _users.Total)" @onclick="() => LoadUsersAsync(_usersPage + 1)">Siguiente</button>
                </div>
            }
        </div>
    </AuthorizeView>
</div>

@code {
    private sealed record Row(ExperimentSessionSnapshotDto Session, Dictionary<string, int> Counts);

    private List<Row>? _rows;
    private Dictionary<string, int> _totals = new(StringComparer.OrdinalIgnoreCase);
    private readonly CancellationTokenSource _disposeSource = new();
    private int _degraded;
    private bool _isLoading;
    private bool _isHistory;
    private bool _disposed;
    private string? _errorMessage;
    private DateTimeOffset? _lastUpdated;
    private Timer? _timer;

    private string PredominantEmotion => _totals.Count == 0 ? "—" : EmotionLabel(_totals.MaxBy(pair => pair.Value).Key);

    private static readonly string[] Roles = ["Participant", "Researcher", "Administrator"];

    [CascadingParameter] public Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    private PagedUsersDto? _users;
    private readonly Dictionary<Guid, string> _pendingRoles = new();
    private string _userQuery = "";
    private int _usersPage = 1;
    private bool _usersBusy;
    private string? _usersError;
    private string? _roleNotice;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        if (!_disposed)
            _timer = new Timer(_ => _ = RefreshAsync(), null, TimeSpan.FromSeconds(10), TimeSpan.FromSeconds(10));

        if (!_disposed && (await AuthenticationState).User.IsInRole("Administrator"))
            await LoadUsersAsync(1);
    }

    private string RoleFor(AuthenticatedUserDto account) => _pendingRoles.GetValueOrDefault(account.Id, account.Role);

    private Task SearchUsersAsync() => LoadUsersAsync(1);

    private async Task LoadUsersAsync(int page)
    {
        if (_usersBusy || _disposed) return;

        _usersBusy = true;
        _usersError = null;

        try
        {
            _users = await AuthApiClient.ListUsersAsync(_userQuery.Trim(), page, _disposeSource.Token);
            _usersPage = page;
            _pendingRoles.Clear();
        }
        catch (OperationCanceledException) when (_disposed) { }
        catch (ApiException exception)
        {
            _usersError = exception.Message;
        }
        finally
        {
            _usersBusy = false;
        }
    }

    private async Task SaveRoleAsync(AuthenticatedUserDto account)
    {
        if (_usersBusy || _users is null || _disposed) return;

        _usersBusy = true;
        _usersError = null;
        _roleNotice = null;

        try
        {
            var updated = await AuthApiClient.SetRoleAsync(account.Id, RoleFor(account), _disposeSource.Token);
            _roleNotice = $"Rol de {updated.FullName} actualizado a {updated.Role}. Debe volver a iniciar sesión.";
            var index = _users.Items.FindIndex(item => item.Id == account.Id);
            if (index >= 0) _users.Items[index] = updated;
        }
        catch (OperationCanceledException) when (_disposed) { }
        catch (ApiException exception)
        {
            // Por ejemplo, un administrador que intenta quitarse su propio rol: se muestra el rechazo y se vuelve al rol real.
            _usersError = exception.Message;
        }
        finally
        {
            _pendingRoles.Remove(account.Id);
            _usersBusy = false;
        }
    }

    private async Task RefreshAsync()
    {
        if (_disposed) return;
        try { await InvokeAsync(LoadAsync); }
        catch (ObjectDisposedException) when (_disposed) { }
        catch (InvalidOperationException) when (_disposed) { }
    }

    private async Task ChangeViewAsync(bool history)
    {
        if (_isLoading || _isHistory == history || _disposed) return;
        _isHistory = history;
        _rows = null;
        _totals = new(StringComparer.OrdinalIgnoreCase);
        _degraded = 0;
        _lastUpdated = null;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_isLoading || _disposed) return;
        var cancellationToken = _disposeSource.Token;
        _isLoading = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            var list = await ExperimentSessionApiClient.ListAllSessionsAsync(cancellationToken);
            var rows = new List<Row>();
            var totals = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
            var degraded = 0;

            foreach (var session in list.Items.Where(session => _isHistory
                ? session.Status is "Completed" or "TimedOut" or "Cancelled"
                : string.Equals(session.Status, "Active", StringComparison.OrdinalIgnoreCase)))
            {
                var result = await ExperimentSessionApiClient.GetSessionResultAsync(session.Id, cancellationToken);
                var counts = result.EmotionReadings
                    .GroupBy(reading => reading.Emotion.Trim(), StringComparer.OrdinalIgnoreCase)
                    .ToDictionary(group => group.Key, group => group.Count(), StringComparer.OrdinalIgnoreCase);
                degraded += result.EmotionReadings.Count(reading => reading.IsDegraded);
                foreach (var (emotion, count) in counts)
                    totals[emotion] = totals.GetValueOrDefault(emotion) + count;
                rows.Add(new Row(session, counts));
            }

            if (!_disposed)
            {
                (_rows, _totals, _degraded) = (rows, totals, degraded);
                _lastUpdated = DateTimeOffset.Now;
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        catch (ApiException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            if (!_disposed)
            {
                await AuthStateProvider.SignOutAsync();
                NavigationManager.NavigateTo("/login?returnUrl=%2Fadmin", replace: true);
            }
        }
        catch (ApiException exception)
        {
            _errorMessage = exception.StatusCode == HttpStatusCode.Forbidden
                ? "Tu cuenta no tiene permiso para ver estas estadísticas."
                : exception.Message;
        }
        catch (HttpRequestException)
        {
            _errorMessage = "No fue posible conectar con el servicio de estadísticas. Intenta actualizar de nuevo.";
        }
        catch (OperationCanceledException)
        {
            _errorMessage = "El servicio tardó demasiado en responder. Intenta actualizar de nuevo.";
        }
        catch (JsonException)
        {
            _errorMessage = "No fue posible leer los datos del servicio de estadísticas.";
        }
        finally
        {
            _isLoading = false;
            if (!_disposed) StateHasChanged();
        }
    }

    private static string StatusLabel(string status) => status switch
    {
        "Active" => "Activa", "Completed" => "Finalizada", "TimedOut" => "Expirada",
        "Cancelled" => "Cancelada", _ => status
    };

    private static string EmotionLabel(string? emotion) => emotion?.Trim().ToLowerInvariant() switch
    {
        "joy" => "Alegría", "neutral" => "Neutral", "sadness" => "Tristeza",
        "confusion" => "Confusión", "anger" => "Enojo", "surprise" => "Sorpresa",
        "fear" => "Miedo", "disgust" => "Asco",
        null or "" => "—", _ => emotion
    };

    public void Dispose()
    {
        _disposed = true;
        _timer?.Dispose();
        _disposeSource.Cancel();
        _disposeSource.Dispose();
    }
}
