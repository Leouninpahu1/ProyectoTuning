@page "/login"
@layout EmptyLayout

@inject AuthApiClient AuthApiClient
@inject NavigationManager NavigationManager
@inject TokenAuthenticationStateProvider AuthStateProvider

<PageTitle>SUE — Iniciar sesión</PageTitle>

<div class="login-container">
    <!-- Mitad Izquierda: Formulario -->
    <div class="login-left paper">
        <div class="login-card rise-in">
            <div class="sue-logo">
                <div class="sue-logo-icon">◦</div>
                <h1 class="sue-logo-text">SUE</h1>
                <p class="sue-logo-subtitle">Sistema de Usuario con Empatía</p>
                <p style="margin-top: 8px; font-size: 14px; color: var(--barro-claro);">
                    Tu espacio para conectar con tus emociones
                </p>
            </div>

            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <div class="card-tierra" style="background: #FDECEC; border-color: #E8B4B4; margin-bottom: 16px; padding: 16px;">
                    <p style="margin: 0; color: #8B4A4A; font-size: 14px;">@_errorMessage</p>
                </div>
            }

            <EditForm FormName="login-form" Model="_model" OnValidSubmit="HandleSubmitAsync">
                <DataAnnotationsValidator />

                <div style="margin-bottom: 16px;">
                    <label style="display: block; margin-bottom: 8px; font-weight: 700; font-size: 14px;">
                        Correo electrónico
                    </label>
                    <InputText class="input-tierra" @bind-Value="_model.Email" 
                               placeholder="tu@email.com" autocomplete="username" />
                    <ValidationMessage For="@(() => _model.Email)" 
                                       style="color: #A87B64; font-size: 13px; margin-top: 4px; display: block;" />
                </div>

                <div style="margin-bottom: 20px;">
                    <label style="display: block; margin-bottom: 8px; font-weight: 700; font-size: 14px;">
                        Contraseña
                    </label>
                    <InputText class="input-tierra" @bind-Value="_model.Password" 
                               type="password" placeholder="••••••••" 
                               autocomplete="current-password" />
                    <ValidationMessage For="@(() => _model.Password)" 
                                       style="color: #A87B64; font-size: 13px; margin-top: 4px; display: block;" />
                </div>

                <button type="submit" class="btn-tierra" disabled="@_isSubmitting">
                    @(_isSubmitting ? "◦ Abriendo tu espacio..." : "◦ Iniciar mi viaje")
                </button>
            </EditForm>

            <p style="text-align: center; margin-top: 24px; font-size: 14px; color: var(--barro-claro);">
                ¿Primera vez aquí? 
                <a href="@BuildRegisterLink()" 
                   style="color: var(--terracota-oscura); font-weight: 800; text-decoration: none;">
                    Crea tu historia
                </a>
            </p>

            <p style="text-align: center; margin-top: 32px; font-size: 12px; color: var(--barro-claro);">
                © 2026 SUE · Conecta con tus emociones
            </p>
        </div>
    </div>

    <!-- Mitad Derecha: Avatar Container -->
    <div class="login-right linen">
        <div class="avatar-container">
            <div style="text-align: center;">
                <div class="avatar-circle breathe" id="avatar-container">
                    <span class="avatar-letter">S</span>
                </div>
                <p style="margin-top: 24px; font-weight: 700; color: var(--barro); 
                          display: flex; align-items: center; justify-content: center; gap: 8px;">
                    <span class="pulse-dot" style="width: 10px; height: 10px; border-radius: 50%; 
                          background: var(--salvia-oscura); display: inline-block;"></span>
                    Tu compañero empático está aquí
                </p>
                <p style="margin-top: 16px; font-family: var(--font-display); 
                          font-size: 32px; font-weight: 700; color: var(--barro); 
                          line-height: 1.2; max-width: 400px;">
                    Conecta con tus emociones en un espacio cálido.
                </p>
                <p style="margin-top: 16px; color: var(--barro-claro); 
                          max-width: 400px; line-height: 1.6;">
                    Un lugar gentil para explorar conversaciones, emociones, bienestar y tu viaje personal.
                </p>
                <!-- AQUÍ PUEDES INSERTAR TU ANIMACIÓN DE AVATAR (Unity, Lottie, GIF, Canvas) -->
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private readonly LoginInputModel _model = new();
    private bool _isSubmitting;
    private string? _errorMessage;

    private async Task HandleSubmitAsync()
    {
        _errorMessage = null;
        _isSubmitting = true;

        try
        {
            var authResult = await AuthApiClient.LoginAsync(new LoginRequestDto
            {
                Email = _model.Email.Trim(),
                Password = _model.Password
            });

            await AuthStateProvider.SignInAsync(authResult);
            NavigationManager.NavigateTo(ResolveReturnUrl(), replace: true);
        }
        catch (ApiException exception)
        {
            _errorMessage = exception.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private string BuildRegisterLink()
    {
        return $"/register?returnUrl={Uri.EscapeDataString(ResolveReturnUrl())}";
    }

    private string ResolveReturnUrl()
    {
        if (string.IsNullOrWhiteSpace(ReturnUrl))
        {
            return "/workspace";
        }

        if (ReturnUrl.StartsWith("http://", StringComparison.OrdinalIgnoreCase)
            || ReturnUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase)
            || ReturnUrl.StartsWith("//", StringComparison.Ordinal))
        {
            return "/workspace";
        }

        return ReturnUrl.StartsWith("/", StringComparison.Ordinal) ? ReturnUrl : $"/{ReturnUrl}";
    }

    private sealed class LoginInputModel
    {
        [Required(ErrorMessage = "El correo es obligatorio.")]
        [EmailAddress(ErrorMessage = "Debes escribir un correo válido.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "La contraseña es obligatoria.")]
        public string Password { get; set; } = string.Empty;
    }
}