@page "/avatar"
@attribute [Authorize]
@using turning.Web.ExperimentSessions
@inject ExperimentSessionApiClient Sessions

<PageTitle>SUE — Avatar</PageTitle>
<div class="sue-page">
    <header class="sue-header"><p class="sue-eyebrow">Compañero</p><h1 class="sue-title">Avatar SUE</h1><p class="sue-subtitle">La expresión se deriva de las lecturas emocionales persistidas.</p></header>
    <SessionSelector SessionId="SessionId" OnSelected="LoadAsync" />
    @if (_error is not null) { <div class="sue-card" role="alert">@_error</div> }
    @if (_session is not null && _avatar is not null)
    {
        <div class="sue-two-cols">
            <div class="sue-avatar-stage"><div class="sue-avatar-frame"><div class="sue-avatar-circle breathe" style="font-size:70px" role="img" aria-label="Expresión @_avatar.ExpressionName">@ExpressionIcon()</div></div><p class="sue-avatar-expression">@_avatar.ExpressionName</p>@if (!_avatar.IsFallback) { <p class="sue-avatar-caption">Intensidad: @_avatar.Intensity.ToString("P0")</p> }</div>
            <div class="sue-card"><h2 class="sue-card-title">Estado real de la expresión</h2><p>Sesión @_session.SessionCode</p><p>@(_avatar.IsFallback ? "Estado neutral de respaldo; no representa una medición." : "Expresión derivada de la última lectura disponible.")</p><p class="sue-subtitle">Esta vista representa la expresión con un símbolo. La animación Unity todavía no está integrada.</p><button class="btn-ghost" @onclick="RefreshAsync">Actualizar expresión</button><a href="/emotions?sessionId=@_session.Id">Ver lecturas</a></div>
        </div>
    }
</div>
@code {
    [SupplyParameterFromQuery] public Guid? SessionId { get; set; }
    private ExperimentSessionSnapshotDto? _session;
    private AvatarDto? _avatar;
    private string? _error;
    private async Task LoadAsync(ExperimentSessionSnapshotDto? session) { _session = session; _avatar = null; await RefreshAsync(); }
    private async Task RefreshAsync()
    {
        if (_session is null) return;
        _error = null;
        try { _avatar = await Sessions.GetAvatarAsync(_session.Id); }
        catch (ApiException ex) { _error = ex.Message; }
    }
    private string ExpressionIcon() => _avatar?.ExpressionName.ToLowerInvariant() switch { "joy" => "☺", "sadness" => "☹", "anger" => "!", "surprise" => "○", _ => "◌" };
}
