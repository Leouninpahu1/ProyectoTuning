@page "/workspace"
@attribute [Authorize]

@using System.Net
@using System.Security.Claims
@using turning.Web.ExperimentSessions

@inject AuthApiClient AuthApiClient
@inject ExperimentSessionApiClient ExperimentSessionApiClient
@inject NavigationManager NavigationManager
@inject TokenAuthenticationStateProvider AuthStateProvider

<PageTitle>SUE — Panel</PageTitle>

<div class="sue-page">
    @if (_isLoading)
    {
        <div class="sue-loading">
            <p class="sue-eyebrow">Perfil</p>
            <h1 class="sue-title">Cargando tu espacio...</h1>
            <p class="sue-subtitle">Consultando tu perfil y sesiones recientes.</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="sue-loading">
            <p class="sue-eyebrow">Error</p>
            <h1 class="sue-title">No fue posible cargar el panel.</h1>
            <p class="sue-subtitle">@_errorMessage</p>
            <button class="btn-tierra" style="max-width: 240px; margin-top: 20px;" @onclick="LoadWorkspaceAsync">
                Reintentar
            </button>
        </div>
    }
    else if (_user is not null)
    {
        <!-- Header bienvenida -->
        <header class="sue-header">
            
            <h1 class="sue-title">Hola, @GetFirstName()</h1>
            <p class="sue-subtitle">Hoy es un buen día para conectar contigo mismo.</p>
        </header>

        <!-- Grid principal -->
        <div class="sue-grid-main">
            <!-- Stats -->
            <div class="sue-stats-grid">
                <div class="sue-stat-card">
                    <div class="sue-stat-icon">◦</div>
                    <p class="sue-stat-value">@(_session is not null ? "1" : "0")</p>
                    <p class="sue-stat-label">Sesión activa</p>
                </div>
                <div class="sue-stat-card">
                    <div class="sue-stat-icon">·</div>
                    <p class="sue-stat-value">@_conversationTurns.Count</p>
                    <p class="sue-stat-label">Mensajes</p>
                </div>
                <div class="sue-stat-card">
                    <div class="sue-stat-icon">◇</div>
                    <p class="sue-stat-value">@(_session?.EmotionSampleCount ?? 0)</p>
                    <p class="sue-stat-label">Emociones</p>
                </div>
                <div class="sue-stat-card">
                    <div class="sue-stat-icon">○</div>
                    <p class="sue-stat-value">@(_session?.ConversationTurnCount ?? 0)</p>
                    <p class="sue-stat-label">Turnos</p>
                </div>
            </div>

            <!-- Card de frase SUE -->
            <div class="sue-quote-card">
                <p class="sue-quote-label">SUE dice</p>
                <p class="sue-quote-text">Cada emoción tiene su lugar en tu jardín interior.</p>
                <span class="sue-quote-icon">◦</span>
            </div>
        </div>

        <!-- Perfil -->
        <div class="sue-card">
            <h2 class="sue-card-title">Tu perfil</h2>
            <div class="sue-info-grid">
                <div>
                    <p class="sue-info-label">Nombre</p>
                    <p class="sue-info-value">@_user.FullName</p>
                </div>
                <div>
                    <p class="sue-info-label">Correo</p>
                    <p class="sue-info-value">@_user.Email</p>
                </div>
                <div>
                    <p class="sue-info-label">Rol</p>
                    <p class="sue-info-value">@_user.Role</p>
                </div>
                <div>
                    <p class="sue-info-label">Sesión expira</p>
                    <p class="sue-info-value">@_tokenExpiryLabel</p>
                </div>
            </div>
        </div>

        @if (_session is null)
        {
            <div class="sue-card">
                <p class="sue-eyebrow">Primera sesión</p>
                <h2 class="sue-card-title">Crear tu primera sesión experimental</h2>
                <p class="sue-subtitle" style="margin-bottom: 20px;">
                    Esto crea una sesión persistida que servirá como base para conversaciones, emociones y el avatar.
                </p>

                <div class="sue-form-field">
                    <label class="sue-form-label">Condición experimental</label>
                    <select class="input-tierra" @bind="_preferredCondition">
                        <option value="AI">IA</option>
                        <option value="Human">Humano</option>
                    </select>
                </div>

                <button class="btn-tierra" style="max-width: 320px; margin-top: 16px;"
                        @onclick="HandleCreateSessionAsync" disabled="@_isCreatingSession">
                    @(_isCreatingSession ? "Creando sesión..." : "◦ Crear sesión")
                </button>
            </div>
        }
        else
        {
            <!-- Info sesión -->
            <div class="sue-card">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 12px;">
                    <h2 class="sue-card-title" style="margin: 0;">Sesión activa</h2>
                    <button class="btn-ghost" style="width: auto; padding: 10px 20px;" 
                            @onclick="HandleCreateSessionAsync" disabled="@_isCreatingSession">
                        @(_isCreatingSession ? "Creando..." : "Nueva sesión")
                    </button>
                </div>

                <div class="sue-info-grid">
                    <div>
                        <p class="sue-info-label">Código</p>
                        <p class="sue-info-value">@_session.SessionCode</p>
                    </div>
                    <div>
                        <p class="sue-info-label">Condición</p>
                        <p class="sue-info-value">@_session.Condition</p>
                    </div>
                    <div>
                        <p class="sue-info-label">Estado</p>
                        <p class="sue-info-value">@_session.Status</p>
                    </div>
                    <div>
                        <p class="sue-info-label">Avatar</p>
                        <p class="sue-info-value">@_session.AvatarState</p>
                    </div>
                    <div>
                        <p class="sue-info-label">Conversación</p>
                        <p class="sue-info-value">@_session.ConversationStage</p>
                    </div>
                    <div>
                        <p class="sue-info-label">Emociones</p>
                        <p class="sue-info-value">@_session.EmotionStage</p>
                    </div>
                    <div>
                        <p class="sue-info-label">Creada</p>
                        <p class="sue-info-value">@_session.CreatedAtUtc.ToLocalTime().ToString("g")</p>
                    </div>
                    <div>
                        <p class="sue-info-label">Siguiente paso</p>
                        <p class="sue-info-value">@_session.AvatarStage</p>
                    </div>
                </div>
            </div>

            <!-- Chat -->
            <div class="sue-card">
                <p class="sue-eyebrow">Conversación</p>
                <h2 class="sue-card-title" style="margin-bottom: 20px;">Habla con SUE</h2>

                @if (IsAiCondition)
                {
                    <p class="sue-info-label" style="margin-bottom: 16px;">
                        Sesión IA activa · cada mensaje tuyo genera una respuesta automática.
                    </p>
                }

                <div class="sue-chat-feed">
                    @if (_conversationTurns.Count == 0)
                    {
                        <div class="sue-chat-empty">
                            Aún no hay mensajes. Escribe el primero para comenzar.
                        </div>
                    }
                    else
                    {
                        @foreach (var turn in _conversationTurns)
                        {
                            <div class="@GetConversationTurnCss(turn)">
                                <div class="sue-chat-meta">
                                    <span>@turn.Sender</span>
                                    <span>@turn.CreatedAtUtc.ToLocalTime().ToString("HH:mm")</span>
                                </div>
                                <p>@turn.Message</p>
                            </div>
                        }
                    }
                </div>

                <div style="margin-top: 20px;">
                    @if (!IsAiCondition)
                    {
                        <div class="sue-form-field">
                            <label class="sue-form-label">Emisor</label>
                            <select class="input-tierra" @bind="_conversationSender">
                                <option value="Participant">Participante</option>
                                <option value="Interlocutor">Interlocutor</option>
                            </select>
                        </div>
                    }

                    <div class="sue-form-field">
                        <label class="sue-form-label">Mensaje</label>
                        <textarea class="input-tierra" rows="3" placeholder="¿Qué hay en tu corazón hoy?"
                                  @bind="_draftMessage"></textarea>
                    </div>

                    <button class="btn-tierra" style="margin-top: 12px;"
                            @onclick="HandleAddConversationTurnAsync" disabled="@_isSubmittingTurn">
                        @(_isSubmittingTurn ? "Guardando..." : "· Enviar mensaje")
                    </button>
                </div>
            </div>
        }
    }
</div>

@code {
    private AuthenticatedUserDto? _user;
    private ExperimentSessionSnapshotDto? _session;
    private List<ConversationTurnSnapshotDto> _conversationTurns = new();
    private bool _isLoading = true;
    private bool _isCreatingSession;
    private bool _isSubmittingTurn;
    private string? _errorMessage;
    private string _tokenExpiryLabel = "No disponible";
    private string _preferredCondition = "AI";
    private string _conversationSender = "Participant";
    private string _draftMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadWorkspaceAsync();
    }

    private string GetFirstName()
    {
        if (string.IsNullOrWhiteSpace(_user?.FullName)) return "amigo";
        return _user.FullName.Split(' ')[0];
    }

    private async Task LoadWorkspaceAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            _user = await AuthApiClient.GetCurrentUserAsync();
            var authenticationState = await AuthStateProvider.GetAuthenticationStateAsync();
            _tokenExpiryLabel = ResolveExpiry(authenticationState.User);
            _session = await ExperimentSessionApiClient.GetLatestAsync();

            if (_session is not null)
            {
                await LoadConversationAsync(_session.Id);
            }
            else
            {
                _conversationTurns.Clear();
            }
        }
        catch (ApiException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            await AuthStateProvider.SignOutAsync();
            NavigationManager.NavigateTo("/login?returnUrl=%2Fworkspace", replace: true);
        }
        catch (ApiException exception)
        {
            _errorMessage = exception.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleCreateSessionAsync()
    {
        _isCreatingSession = true;
        _errorMessage = null;

        try
        {
            _session = await ExperimentSessionApiClient.CreateBootstrapAsync(new CreateExperimentSessionRequestDto
            {
                PreferredCondition = _preferredCondition
            });

            _conversationTurns.Clear();
            _draftMessage = string.Empty;
            _conversationSender = "Participant";
        }
        catch (ApiException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            await AuthStateProvider.SignOutAsync();
            NavigationManager.NavigateTo("/login?returnUrl=%2Fworkspace", replace: true);
        }
        catch (ApiException exception)
        {
            _errorMessage = exception.Message;
        }
        finally
        {
            _isCreatingSession = false;
        }
    }

    private async Task LoadConversationAsync(Guid sessionId)
    {
        var turns = await ExperimentSessionApiClient.GetConversationTurnsAsync(sessionId);
        _conversationTurns = new List<ConversationTurnSnapshotDto>(turns);
    }

    private async Task HandleAddConversationTurnAsync()
    {
        if (_session is null || string.IsNullOrWhiteSpace(_draftMessage))
        {
            return;
        }

        _isSubmittingTurn = true;
        _errorMessage = null;

        try
        {
            await ExperimentSessionApiClient.AddConversationTurnAsync(_session.Id, new AddConversationTurnRequestDto
            {
                Sender = IsAiCondition ? "Participant" : _conversationSender,
                Message = _draftMessage
            });

            await LoadConversationAsync(_session.Id);
            _draftMessage = string.Empty;
            _session = await ExperimentSessionApiClient.GetLatestAsync();
        }
        catch (ApiException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            await AuthStateProvider.SignOutAsync();
            NavigationManager.NavigateTo("/login?returnUrl=%2Fworkspace", replace: true);
        }
        catch (ApiException exception)
        {
            _errorMessage = exception.Message;
        }
        finally
        {
            _isSubmittingTurn = false;
        }
    }

    private static string GetConversationTurnCss(ConversationTurnSnapshotDto turn)
    {
        return string.Equals(turn.Sender, "Interlocutor", StringComparison.OrdinalIgnoreCase)
            ? "sue-chat-bubble sue-chat-sue"
            : "sue-chat-bubble sue-chat-user";
    }

    private bool IsAiCondition => string.Equals(_session?.Condition, "AI", StringComparison.OrdinalIgnoreCase);

    private static string ResolveExpiry(ClaimsPrincipal user)
    {
        var expValue = user.FindFirst("exp")?.Value;

        if (long.TryParse(expValue, out var unixSeconds))
        {
            return DateTimeOffset.FromUnixTimeSeconds(unixSeconds).LocalDateTime.ToString("g");
        }

        return "No disponible";
    }
}