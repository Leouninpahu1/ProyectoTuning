@page "/workspace"
@attribute [Authorize]
@inject AuthApiClient Auth
@inject ExperimentSessionApiClient Sessions
@inject NavigationManager Navigation
@using turning.Web.ExperimentSessions

<PageTitle>SUE — Panel</PageTitle>
<div class="sue-page">
    <header class="sue-header"><p class="sue-eyebrow">Tu espacio</p><h1 class="sue-title">Bienvenido a SUE</h1><p class="sue-subtitle">Prepara tu sesión y continúa el experimento.</p></header>
    @if (_error is not null) { <div class="sue-card" role="alert"><p>@_error</p><button class="btn-ghost" @onclick="LoadAsync">Reintentar</button></div> }
    @if (_user is not null)
    {
        <div class="sue-card">
            <h2 class="sue-card-title">Hola, @_user.FullName</h2>
            <p>@_user.Email · @_user.Role</p>
            <p class="sue-subtitle">Tu identificador: <code>@_user.Id</code></p>
            <a class="btn-tierra" style="display:inline-block;width:auto" href="/sessions">Mis sesiones y unión por código</a>
        </div>
        @if (_session is not null)
        {
            <div class="sue-card">
                <h2 class="sue-card-title">Última sesión: @_session.SessionCode</h2>
                <p>Estado: @_session.Status · @_session.ConversationTurnCount mensajes · @_session.EmotionSampleCount lecturas emocionales</p>
                <a class="btn-ghost" href="/conversations?sessionId=@_session.Id">Abrir conversación</a>
                @if (_session.IsTerminal) { <a class="btn-ghost" href="/surveys?sessionId=@_session.Id">Responder encuesta</a> }
            </div>
        }
        <AuthorizeView Roles="Researcher,Administrator"><div class="sue-card"><h2 class="sue-card-title">Investigación</h2><p>Consulta la cola de interlocutores en Sesiones y los datos persistidos en Resultados.</p><a href="/results">Consultar resultados</a></div></AuthorizeView>
    }
    else if (_error is null) { <div class="sue-card" role="status">Cargando perfil...</div> }
</div>
@code {
    private AuthenticatedUserDto? _user;
    private ExperimentSessionSnapshotDto? _session;
    private string? _error;
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync()
    {
        _error = null;
        try { _user = await Auth.GetCurrentUserAsync(); _session = await Sessions.GetLatestAsync(); }
        catch (ApiException ex) { _error = ex.Message; if (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized) Navigation.NavigateTo("/login"); }
    }
}
