@page "/conversations"
@attribute [Authorize]
@implements IAsyncDisposable
@using System.Net
@using turning.Web.ExperimentSessions
@inject ExperimentSessionApiClient Sessions
@inject TokenAuthenticationStateProvider AuthState
@inject NavigationManager Navigation

<PageTitle>SUE — Conversación</PageTitle>
<div class="sue-page">
    <header class="sue-header">
        <p class="sue-eyebrow">Conversación</p>
        <h1 class="sue-title">Habla con SUE</h1>
        <p class="sue-subtitle">Una sesión, una conversación y un espacio para escuchar.</p>
    </header>
    <SessionSelector SessionId="SessionId" OnSelected="SelectSessionAsync" />
    @if (_error is not null)
    {
        <div class="sue-card" role="alert"><p>@_error</p></div>
    }
    @if (_session is not null)
    {
        <div class="sue-card">
            <p><strong>@_session.SessionCode</strong> · Estado: @_session.Status</p>
            @if (_session.ExpiresAtUtc.HasValue && _session.Status == "Active")
            {
                <p role="timer">Tiempo máximo restante: @RemainingTime()</p>
            }
            @if (_session.Status == "Created")
            {
                <p>La sesión todavía no ha comenzado. El participante debe iniciarla cuando esté listo.</p>
                @if (_session.IsOwner)
                {
                    <button class="btn-tierra" style="width:auto" disabled="@_busy" @onclick="ActivateAsync">Iniciar sesión experimental</button>
                }
            }
            else if (_session.IsTerminal)
            {
                <p>Esta sesión ha terminado. Puedes leer la conversación, pero ya no enviar mensajes.</p>
                @if (_session.IsOwner)
                {
                    <a class="btn-ghost" href="/surveys?sessionId=@_session.Id">Responder encuesta</a>
                }
            }
            else if (!_session.CanConverse)
            {
                <p>Estás consultando esta conversación como observador.</p>
            }
            @if (_session.IsOwner && _session.Status == "Active")
            {
                <button class="btn-ghost" disabled="@_busy" @onclick="CompleteAsync">Finalizar y responder encuesta</button>
            }
            @if (!_session.IsTerminal)
            {
                <AuthorizeView Roles="Administrator">
                    <div class="sue-form-field" style="margin-top:16px">
                        <label for="cancel-reason" class="sue-form-label">Motivo de cancelación administrativa</label>
                        <input id="cancel-reason" class="input-tierra" @bind="_cancelReason" />
                        <button class="btn-ghost" disabled="@(_busy || string.IsNullOrWhiteSpace(_cancelReason))" @onclick="CancelAsync">Cancelar sesión</button>
                    </div>
                </AuthorizeView>
            }
            <p class="sue-subtitle" role="status">@(_busy ? "Procesando…" : "Los mensajes y el estado se actualizan automáticamente.")</p>
        </div>
        <div class="sue-card">
            <div class="sue-chat-feed" aria-label="Mensajes de la conversación" aria-live="polite" style="padding:16px;min-height:240px;max-height:520px">
                @if (_turns.Count == 0)
                {
                    <p>Aún no hay mensajes.</p>
                }
                @foreach (var turn in _turns)
                {
                    <div @key="turn.Id" class="sue-chat-bubble @(IsMine(turn) ? "sue-chat-user" : "sue-chat-sue")">
                        <div class="sue-chat-meta"><span>@SenderLabel(turn)</span><time>@turn.CreatedAtUtc.ToLocalTime().ToString("HH:mm:ss")</time></div>
                        <p>@turn.Message</p>
                    </div>
                }
            </div>
            @if (_session.CanConverse && _session.Status == "Active")
            {
                <div class="sue-form-field" style="margin-top:20px">
                    <label class="sue-form-label" for="chat-message">Tu mensaje</label>
                    <textarea id="chat-message" class="input-tierra" rows="3" maxlength="4000" @bind="_draft" @bind:event="oninput" disabled="@_busy"></textarea>
                    <button class="btn-tierra" style="margin-top:12px" @onclick="SendAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_draft))">@(_busy ? "Enviando…" : "Enviar")</button>
                </div>
            }
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery] public Guid? SessionId { get; set; }
    private ExperimentSessionSnapshotDto? _session;
    private List<ConversationTurnSnapshotDto> _turns = [];
    private string _draft = "";
    private string _cancelReason = "";
    private string? _error;
    private bool _busy;
    private CancellationTokenSource? _lifetime;
    private Task? _poll;
    private readonly SemaphoreSlim _requests = new(1, 1);

    private async Task SelectSessionAsync(ExperimentSessionSnapshotDto? session)
    {
        await StopPollingAsync();
        _session = session;
        _turns.Clear();
        _draft = "";
        _error = null;
        if (session is null) return;
        _busy = true;
        _lifetime = new CancellationTokenSource();
        try
        {
            await RefreshAsync(_lifetime.Token);
            if (!_session!.IsTerminal) _poll = PollAsync(_lifetime.Token);
        }
        catch (ApiException ex) { await HandleErrorAsync(ex); }
        catch (OperationCanceledException) { }
        finally { _busy = false; }
    }

    private async Task PollAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                if (_busy) continue;
                try
                {
                    await InvokeAsync(async () =>
                    {
                        await _requests.WaitAsync(ct);
                        try { if (!_busy) await RefreshAsync(ct); }
                        finally { _requests.Release(); }
                        StateHasChanged();
                    });
                    if (_session?.IsTerminal == true) break;
                }
                catch (ApiException ex)
                {
                    await InvokeAsync(async () => { await HandleErrorAsync(ex); StateHasChanged(); });
                    if (ex.StatusCode is HttpStatusCode.Unauthorized or HttpStatusCode.Forbidden or HttpStatusCode.NotFound) break;
                }
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
    }

    private async Task RefreshAsync(CancellationToken ct)
    {
        if (_session is null) return;
        var id = _session.Id;
        var snapshot = await Sessions.GetByIdAsync(id, ct);
        var cursor = _turns.Count == 0 ? 0 : _turns.Max(t => t.SequenceNumber);
        IReadOnlyList<ConversationTurnSnapshotDto> turns;
        do
        {
            turns = await Sessions.GetConversationTurnsAsync(id, ct, cursor);
            if (ct.IsCancellationRequested || _session?.Id != id) return;
            foreach (var turn in turns)
                if (!_turns.Any(t => t.Id == turn.Id)) _turns.Add(turn);
            if (turns.Count > 0) cursor = turns.Max(t => t.SequenceNumber);
        } while (turns.Count == 200);
        _turns.Sort((left, right) => left.SequenceNumber.CompareTo(right.SequenceNumber));
        _session = snapshot;
    }

    private async Task SendAsync()
    {
        if (_busy || _session is null || string.IsNullOrWhiteSpace(_draft)) return;
        _busy = true;
        _error = null;
        var ct = _lifetime!.Token;
        var locked = false;
        try
        {
            await _requests.WaitAsync(ct);
            locked = true;
            await Sessions.AddConversationTurnAsync(_session.Id, new() { Message = _draft.Trim() }, ct);
            _draft = "";
            await RefreshAsync(ct);
        }
        catch (ApiException ex) { await HandleErrorAsync(ex); }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
        finally { if (locked) _requests.Release(); _busy = false; }
    }

    private Task ActivateAsync() => TransitionAsync(false);
    private Task CompleteAsync() => TransitionAsync(true);
    private async Task CancelAsync()
    {
        if (_busy || _session is null || string.IsNullOrWhiteSpace(_cancelReason)) return;
        _busy = true; _error = null;
        await _requests.WaitAsync();
        try { _session = await Sessions.CancelAsync(_session.Id, _cancelReason.Trim()); }
        catch (ApiException ex) { await HandleErrorAsync(ex); }
        finally { _requests.Release(); _busy = false; }
    }
    private async Task TransitionAsync(bool complete)
    {
        if (_busy || _session is null) return;
        _busy = true;
        _error = null;
        await _requests.WaitAsync();
        try
        {
            _session = complete ? await Sessions.CompleteAsync(_session.Id) : await Sessions.ActivateAsync(_session.Id);
            if (complete) Navigation.NavigateTo($"/surveys?sessionId={_session.Id}");
        }
        catch (ApiException ex) { await HandleErrorAsync(ex); }
        finally { _requests.Release(); _busy = false; }
    }

    private async Task HandleErrorAsync(ApiException ex)
    {
        _error = ex.Message;
        if (ex.StatusCode == HttpStatusCode.Unauthorized)
        {
            await AuthState.SignOutAsync();
            Navigation.NavigateTo("/login", replace: true);
        }
    }

    private bool IsMine(ConversationTurnSnapshotDto turn) => _session?.ParticipationRole switch
    {
        "Owner" => turn.Sender == "Participant",
        "Interlocutor" => turn.Sender == "Interlocutor",
        _ => false
    };
    private string SenderLabel(ConversationTurnSnapshotDto turn) => IsMine(turn) ? "Tú" : turn.Sender == "Participant" ? "Participante" : "SUE";
    private string RemainingTime() => TimeSpan.FromSeconds(Math.Max(0, (_session!.ExpiresAtUtc!.Value - DateTime.UtcNow).TotalSeconds)).ToString(@"mm\:ss");
    private async Task StopPollingAsync()
    {
        if (_lifetime is null) return;
        await _lifetime.CancelAsync();
        if (_poll is not null) await _poll;
        _lifetime.Dispose();
        _lifetime = null;
        _poll = null;
    }
    public async ValueTask DisposeAsync() => await StopPollingAsync();
}
