@page "/settings"
@attribute [Authorize]
@inject AuthApiClient Auth

<PageTitle>SUE — Configuración</PageTitle>
<div class="sue-page">
    <header class="sue-header"><p class="sue-eyebrow">Cuenta</p><h1 class="sue-title">Configuración</h1><p class="sue-subtitle">Consulta tu cuenta y las acciones disponibles para tu rol.</p></header>
    @if (_error is not null) { <div class="sue-card" role="alert">@_error</div> }
    @if (_user is not null) { <div class="sue-card"><h2 class="sue-card-title">Tu perfil</h2><p>@_user.FullName · @_user.Email</p><p>Rol: @_user.Role</p><p>Identificador: <code>@_user.Id</code></p><p class="sue-subtitle">La edición de nombre, idioma y recordatorios aún no está disponible.</p></div> }
    <AuthorizeView Roles="Administrator">
        <div class="sue-card">
            <h2 class="sue-card-title">Asignar rol de usuario</h2>
            <p>Usa el identificador que figura en el perfil de la cuenta. El usuario debe iniciar sesión de nuevo para renovar sus permisos.</p>
            <form @onsubmit="SaveRoleAsync" @onsubmit:preventDefault>
                <label class="sue-form-label" for="role-user">Identificador del usuario</label><input id="role-user" class="input-tierra" @bind="_targetId" required />
                <label class="sue-form-label" for="role-value">Rol</label><select id="role-value" class="input-tierra" @bind="_role"><option>Participant</option><option>Researcher</option><option>Administrator</option></select>
                <button class="btn-tierra" style="margin-top:16px" disabled="@_busy" type="submit">Guardar rol</button>
            </form>
            @if (_confirmation is not null) { <p role="status">@_confirmation</p> }
        </div>
    </AuthorizeView>
</div>
@code {
    private AuthenticatedUserDto? _user;
    private string _targetId = "", _role = "Participant";
    private string? _error, _confirmation;
    private bool _busy;
    protected override async Task OnInitializedAsync() { try { _user = await Auth.GetCurrentUserAsync(); } catch (ApiException ex) { _error = ex.Message; } }
    private async Task SaveRoleAsync()
    {
        if (_busy) return;
        _error = null; _confirmation = null;
        if (!Guid.TryParse(_targetId, out var id)) { _error = "Escribe un identificador de usuario válido."; return; }
        _busy = true;
        try { var user = await Auth.SetRoleAsync(id, _role); _confirmation = $"Rol de {user.FullName} actualizado a {user.Role}. Debe volver a iniciar sesión."; }
        catch (ApiException ex) { _error = ex.Message; }
        finally { _busy = false; }
    }
}
