@page "/register"
@layout EmptyLayout

@inject AuthApiClient AuthApiClient
@inject NavigationManager NavigationManager
@inject TokenAuthenticationStateProvider AuthStateProvider

<PageTitle>SUE — Crear cuenta</PageTitle>

<div class="login-container">
    <!-- Mitad Izquierda: Formulario -->
    <div class="login-left paper">
        <div class="login-card rise-in">
            <div class="sue-logo">
                <div class="sue-logo-icon">◦</div>
                <h1 class="sue-logo-text">SUE</h1>
                <p class="sue-logo-subtitle">Sistema de Usuario con Empatía</p>
                <p style="margin-top: 8px; font-size: 14px; color: var(--barro-claro);">
                    Comienza tu historia personal
                </p>
            </div>

            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <div class="card-tierra" style="background: #FDECEC; border-color: #E8B4B4; margin-bottom: 16px; padding: 16px;">
                    <p style="margin: 0; color: #8B4A4A; font-size: 14px;">@_errorMessage</p>
                </div>
            }

            <EditForm FormName="register-form" Model="_model" OnValidSubmit="HandleSubmitAsync">
                <DataAnnotationsValidator />

                <div style="margin-bottom: 16px;">
                    <label style="display: block; margin-bottom: 8px; font-weight: 700; font-size: 14px;">
                        Nombre completo
                    </label>
                    <InputText class="input-tierra" @bind-Value="_model.FullName" 
                               placeholder="Tu nombre" autocomplete="name" />
                    <ValidationMessage For="@(() => _model.FullName)" 
                                       style="color: #A87B64; font-size: 13px; margin-top: 4px; display: block;" />
                </div>

                <div style="margin-bottom: 16px;">
                    <label style="display: block; margin-bottom: 8px; font-weight: 700; font-size: 14px;">
                        Correo electrónico
                    </label>
                    <InputText class="input-tierra" @bind-Value="_model.Email" 
                               placeholder="tu@email.com" autocomplete="username" />
                    <ValidationMessage For="@(() => _model.Email)" 
                                       style="color: #A87B64; font-size: 13px; margin-top: 4px; display: block;" />
                </div>

                <div style="margin-bottom: 16px;">
                    <label style="display: block; margin-bottom: 8px; font-weight: 700; font-size: 14px;">
                        Contraseña
                    </label>
                    <InputText class="input-tierra" @bind-Value="_model.Password" 
                               type="password" placeholder="Al menos 6 caracteres" 
                               autocomplete="new-password" />
                    <ValidationMessage For="@(() => _model.Password)" 
                                       style="color: #A87B64; font-size: 13px; margin-top: 4px; display: block;" />
                </div>

                <div style="margin-bottom: 20px;">
                    <label style="display: block; margin-bottom: 8px; font-weight: 700; font-size: 14px;">
                        Confirmar contraseña
                    </label>
                    <InputText class="input-tierra" @bind-Value="_model.ConfirmPassword" 
                               type="password" placeholder="Repite tu contraseña" 
                               autocomplete="new-password" />
                    <ValidationMessage For="@(() => _model.ConfirmPassword)" 
                                       style="color: #A87B64; font-size: 13px; margin-top: 4px; display: block;" />
                </div>

                <button type="submit" class="btn-tierra" disabled="@_isSubmitting">
                    @(_isSubmitting ? "◦ Creando tu historia..." : "◦ Comenzar mi viaje")
                </button>
            </EditForm>

            <p style="text-align: center; margin-top: 24px; font-size: 14px; color: var(--barro-claro);">
                ¿Ya tienes cuenta? 
                <a href="@BuildLoginLink()" 
                   style="color: var(--terracota-oscura); font-weight: 800; text-decoration: none;">
                    Ir al inicio de sesión
                </a>
            </p>

            <p style="text-align: center; margin-top: 32px; font-size: 12px; color: var(--barro-claro);">
                © 2026 SUE · Conecta con tus emociones
            </p>
        </div>
    </div>

    <!-- Mitad Derecha: Decorativa -->
    <div class="login-right linen">
        <div class="avatar-container">
            <div style="text-align: center;">
                <div class="avatar-circle breathe">
                    <span class="avatar-letter">·</span>
                </div>
                <p style="margin-top: 32px; font-family: var(--font-display); 
                          font-size: 34px; font-weight: 700; color: var(--barro); 
                          line-height: 1.2; max-width: 420px;">
                    Una manera más cálida de escucharte.
                </p>
                <p style="margin-top: 16px; color: var(--barro-claro); 
                          max-width: 400px; line-height: 1.6;">
                    SUE está diseñado como un espacio empático para la reflexión, la conversación y la conciencia emocional.
                </p>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private readonly RegisterInputModel _model = new();
    private bool _isSubmitting;
    private string? _errorMessage;

    private async Task HandleSubmitAsync()
    {
        _errorMessage = null;
        _isSubmitting = true;

        try
        {
            var authResult = await AuthApiClient.RegisterAsync(new RegisterRequestDto
            {
                FullName = _model.FullName.Trim(),
                Email = _model.Email.Trim(),
                Password = _model.Password
            });

            await AuthStateProvider.SignInAsync(authResult);
            NavigationManager.NavigateTo(ResolveReturnUrl(), replace: true);
        }
        catch (ApiException exception)
        {
            _errorMessage = exception.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private string BuildLoginLink()
    {
        return $"/login?returnUrl={Uri.EscapeDataString(ResolveReturnUrl())}";
    }

    private string ResolveReturnUrl()
    {
        if (string.IsNullOrWhiteSpace(ReturnUrl))
        {
            return "/workspace";
        }

        if (ReturnUrl.StartsWith("http://", StringComparison.OrdinalIgnoreCase)
            || ReturnUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase)
            || ReturnUrl.StartsWith("//", StringComparison.Ordinal))
        {
            return "/workspace";
        }

        return ReturnUrl.StartsWith("/", StringComparison.Ordinal) ? ReturnUrl : $"/{ReturnUrl}";
    }

    private sealed class RegisterInputModel
    {
        [Required(ErrorMessage = "El nombre es obligatorio.")]
        public string FullName { get; set; } = string.Empty;

        [Required(ErrorMessage = "El correo es obligatorio.")]
        [EmailAddress(ErrorMessage = "Debes escribir un correo válido.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "La contraseña es obligatoria.")]
        [MinLength(6, ErrorMessage = "La contraseña debe tener al menos 6 caracteres.")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Debes confirmar la contraseña.")]
        [Compare(nameof(Password), ErrorMessage = "Las contraseñas no coinciden.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}