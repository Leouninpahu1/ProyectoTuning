@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject TokenAuthenticationStateProvider AuthStateProvider

<div class="sue-layout">
    <!-- Sidebar Desktop -->
    <aside class="sue-sidebar-wrapper">
        <NavMenu />
    </aside>

    <!-- Main -->
    <main class="sue-main">
        <!-- Header Mobile -->
        <header class="sue-mobile-header">
            <div class="sue-mobile-brand">
                <span class="sue-mobile-icon">◦</span>
                <span class="sue-mobile-text">SUE</span>
            </div>
            <button class="sue-mobile-menu-btn" @onclick="ToggleMobileMenu">☰</button>
        </header>

        <!-- Menú móvil desplegable -->
        @if (_mobileMenuOpen)
        {
            <div class="sue-mobile-menu">
                <NavMenu />
            </div>
        }

        <!-- Contenido -->
        <article class="sue-content">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _mobileMenuOpen;

    private void ToggleMobileMenu()
    {
        _mobileMenuOpen = !_mobileMenuOpen;
    }
}