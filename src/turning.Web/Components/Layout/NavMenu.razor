@inject NavigationManager NavigationManager
@inject TokenAuthenticationStateProvider AuthStateProvider

<div class="sue-sidebar">
    <!-- Logo -->
    <div class="sue-sidebar-logo">
        <div class="sue-sidebar-logo-icon">◦</div>
        <div>
            <p class="sue-sidebar-logo-text">SUE</p>
            <p class="sue-sidebar-logo-sub">Espacio de empatía</p>
        </div>
    </div>

    <!-- Navegación -->
    <nav class="sue-nav">
        <NavLink class="sue-nav-item" href="/workspace" Match="NavLinkMatch.All">
            <span class="sue-nav-icon">◦</span> <span class="sue-nav-text">Home</span>
        </NavLink>
        <NavLink class="sue-nav-item" href="/sessions">
            <span class="sue-nav-icon">—</span> <span class="sue-nav-text">Sesiones de Experiencia</span>
        </NavLink>
        <NavLink class="sue-nav-item" href="/conversations">
            <span class="sue-nav-icon">·</span> <span class="sue-nav-text">Conversaciones Emocionales</span>
        </NavLink>
        <NavLink class="sue-nav-item" href="/emotions">
            <span class="sue-nav-icon">◇</span> <span class="sue-nav-text">Lectura de Emociones</span>
        </NavLink>
        <NavLink class="sue-nav-item" href="/surveys">
            <span class="sue-nav-icon">○</span> <span class="sue-nav-text">Encuestas de Bienestar</span>
        </NavLink>
        <NavLink class="sue-nav-item" href="/avatar">
            <span class="sue-nav-icon">⌁</span> <span class="sue-nav-text">Avatar SUE</span>
        </NavLink>
        <NavLink class="sue-nav-item" href="/results">
            <span class="sue-nav-icon">▤</span> <span class="sue-nav-text">Resultados y Análisis</span>
        </NavLink>
        <NavLink class="sue-nav-item" href="/settings">
            <span class="sue-nav-icon">⚙</span> <span class="sue-nav-text">Configuración</span>
        </NavLink>
    </nav>

    <!-- Logout -->
    <div class="sue-sidebar-footer">
        <button class="sue-nav-item sue-logout" @onclick="HandleLogoutAsync">
            <span class="sue-nav-icon">↗</span> <span class="sue-nav-text">Cerrar sesión</span>
        </button>
    </div>
</div>

@code {
    private async Task HandleLogoutAsync()
    {
        await AuthStateProvider.SignOutAsync();
        NavigationManager.NavigateTo("/login", replace: true);
    }
}